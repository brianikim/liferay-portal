			CommerceNavigator.gotoMiniCart();
		}

		task ("And types some characters along with a comma on the quick add-to-cart search bar") {
			Type(
				locator1 = "Publications#KEYWORD_TEXTFIELD",
				value1 = ",abc123,");
		}

		task ("Then no alert error is thrown") {
