@component-name = "portal-commerce"
definition {

	property browser.chrome.version = "139.0";
	property custom.properties = "feature.flag.LPD-11235=true";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Product Info Management";

	setUp {
		CommerceConfiguration.commerceSetUp(storeFront = "true");

		task ("Enable private pages") {
			PagesAdmin.enablePrivatePages();
		}

		task ("Enable CKE4") {
			PagesAdmin.enableCKE4();
		}
	}

	tearDown {
		CommerceConfiguration.commerceTearDown();
	}

	@description = "[Please Update]"
	@ignore = "true"
	@priority = 4
	test VerifyIfSaveAndSaveAsDraftButtonsAreNotPresent {

		// TODO COMMERCE-7074 VerifyIfSaveAndSaveAsDraftButtonsAreNotPresent

	}

}