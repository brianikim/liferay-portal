@component-name = "portal-commerce"
definition {

	property browser.chrome.version = "139.0";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Product Info Management";

	setUp {
		CommerceConfiguration.commerceSetUp(minium = "true");

		task ("Enable private pages") {
			PagesAdmin.enablePrivatePages();
		}
	}

	tearDown {
		CommerceConfiguration.commerceTearDown();
	}

	@description = "This is a test for COMMERCE-10053. An error message shows up when the eligibility element is already linked"
	@priority = 3
	test CannotSelectPaymentMethodEligibilitiesTwice {
		property portal.acceptance = "false";

		task ("Given an active payment term is created") {
			CommerceJSONTermsAndConditionsAPI._addCommerceTermsAndConditions(termsType = "Payment");
		}

		task ("And an order type is created") {
			CommerceJSONOrdersAPI._addOrderType(
				active = "true",
				orderTypeName = "Order Type Test");
		}

		task ("And Money Order payment method is set as active") {
			CommerceChannels.openChannelsAdmin();

			CommerceNavigator.gotoEntry(entryName = "Minium Portal");

			CommerceChannels.activatePaymentMethod(paymentMethod = "Money Order");
		}

		task ("And Money Order's eligibility is set specifically to Payment Term 1 and Order Type Test") {
			CommerceEntry.setEntryEligibility(
				orderTypesEligibility = "Order Type Test",
				paymentMethod = "Money Order",
				paymentTermsEligibility = "Payment Term 1");
		}

		task ("When the admin selects the same order type eligibility once again") {
			CommerceEntry.setEntryEligibility(
				orderTypesEligibility = "Order Type Test",
				unpublish = "true");
		}

		task ("Then an error message is shown") {
			Alert.viewErrorMessage(errorMessage = "The payment method group relation qualifier already exists.");
		}

		task ("When the admin selects the same term eligibility once again") {
			CommerceEntry.setEntryEligibility(
				paymentTermsEligibility = "Payment Term 1",
				unpublish = "true");
		}

		task ("Then an error message is shown") {
			Alert.viewErrorMessage(errorMessage = "The payment method group relation qualifier already exists.");
		}
	}

	@description = "This is a test for COMMERCE-10053. An error message shows up when the eligibility element is already linked"
	@priority = 3
	test CannotSelectShippingMethodEligibilitiesTwice {
		property portal.acceptance = "false";

		task ("Given an active delivery term is created") {
			CommerceJSONTermsAndConditionsAPI._addCommerceTermsAndConditions(termsType = "Delivery");
		}

		task ("And an order type is created") {
			CommerceJSONOrdersAPI._addOrderType(
				active = "true",
				orderTypeName = "Order Type Test");
		}

		task ("And the admin navigates to Minium Portal channel entry") {
			CommerceChannels.openChannelsAdmin();

			CommerceNavigator.gotoEntry(entryName = "Minium Portal");
		}

		task ("And Flat Rate's eligibility is set specifically to Delivery Term 1 and Order Type Test") {
			CommerceEntry.setEntryEligibility(
				deliveryTermsEligibility = "Delivery Term 1",
				orderTypesEligibility = "Order Type Test",
				shippingMethod = "Flat Rate",
				shippingOption = "Standard Delivery");
		}

		task ("When the admin selects the same order type eligibility once again") {
			CommerceEntry.setEntryEligibility(
				orderTypesEligibility = "Order Type Test",
				shippingOption = "Standard Delivery",
				unpublish = "true");
		}

		task ("Then an error message is shown") {
			Alert.viewErrorMessage(errorMessage = "The shipping fixed option qualifier already exists.");
		}

		task ("When the admin selects the same term eligibility once again") {
			CommerceEntry.setEntryEligibility(
				deliveryTermsEligibility = "Delivery Term 1",
				unpublish = "true");
		}

		task ("Then an error message is shown") {
			Alert.viewErrorMessage(errorMessage = "The shipping fixed option qualifier already exists");
		}
	}

	@description = "This is a test for COMMERCE-11938. The user can use an email with more than 75 characters in the To field"
	@priority = 4
	test CanUseLongEmailAdressInNotificationTemplates {
		property portal.acceptance = "false";

		task ("Given the user goes to the Channels Admin") {
			CommerceChannels.openChannelsAdmin();

			CommerceNavigator.gotoEntry(entryName = "Minium Portal");
		}

		task ("And the user creates a new notifications template") {
			CommerceEntry.gotoMenuTab(menuTab = "Notification Templates DEPRECATED");

			Click(locator1 = "Button#PLUS");

			SelectFrameTop();

			CommerceEntry.addNewNotificationTemplate(
				entryName = "Test Notification Template",
				fromAddress = "test@liferay.com",
				fromName = "Test",
				notificationType = "Order Placed");
		}

		task ("When in the field To the user place an email address with more than 75 characters") {
			Type(
				key_fieldLabel = "To",
				locator1 = "TextInput#GENERIC_TEXT_INPUT",
				value1 = "customemailadresswithmorethan75charactersintofieldonthenotificationstemplates@liferay.com");
		}

		task ("Then the Notification Template is successfully saved") {
			Button.clickSave();

			Alert.viewSuccessMessage();

			Click(locator1 = "Icon#CLOSE");

			SelectFrameTop();

			AssertVisible(
				key_entryName = "Test Notification Template",
				locator1 = "CommerceNavigation#ENTRY_NAME");

			CommerceNavigator.gotoEntry(entryName = "Test Notification Template");

			SelectFrame.selectFrameNoLoading(locator1 = "CommerceEntry#IFRAME_SIDE_PANEL");

			AssertVisible(
				key_fieldLabel = "To",
				locator1 = "TextInput#GENERIC_TEXT_INPUT",
				value1 = "customemailadresswithmorethan75charactersintofieldonthenotificationstemplates@liferay.com");
		}
	}

	@description = "This is a test for COMMERCE-4270. CheckAvalaraTaxPresence"
	@priority = 3
	test CheckAvalaraTaxPresence {
		property portal.acceptance = "false";
		property portal.release = "false";

		CommerceNavigator.gotoPortlet(
			category = "Settings",
			portlet = "Avalara Connector");

		CommerceChannels.avalaraConnection();

		CommerceChannels.openChannelsAdmin();

		CommerceNavigator.gotoEntry(entryName = "Minium Portal");

		Click(
			key_entryName = "Avalara",
			locator1 = "CommerceEntry#CHANNELS_GENERAL_TAB_EDITS");

		SelectFrame.selectFrameNoLoading(locator1 = "CommerceEntry#IFRAME_SIDE_PANEL");

		AssertTextEquals(
			key_text = "Name",
			locator1 = "TextInput#ANY",
			value1 = "Avalara");

		AssertTextEquals(
			key_text = "Description",
			locator1 = "TextInput#ANY",
			value1 = "Avalara Type Rate Description");

		Check.checkToggleSwitch(
			key_toggleSwitchLabel = "Percentage",
			locator1 = "ToggleSwitch#ANY_TOGGLE_SWITCH");

		Check.checkToggleSwitch(
			key_toggleSwitchLabel = "Active",
			locator1 = "ToggleSwitch#ANY_TOGGLE_SWITCH");

		Button.clickSave();

		Alert.viewSuccessMessage();

		CommerceEntry.gotoMenuTab(menuTab = "Settings");

		AssertElementPresent(
			key_warningMessage = "Configure Credentials Before Continuing",
			locator1 = "Message#WARNING_SPECIFIC");

		CommerceEntry.gotoMenuTab(menuTab = "Avalara Tax Rates");

		AssertElementPresent(locator1 = "CommerceNavigation#EMPTY_SEARCH_CONTAINER");
	}

	@description = "[Please Update]"
	@ignore = "Test Stub"
	@priority = 4
	test CompleteCheckoutWithDefaultPaymentMethod {

